# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any other .env file. Production values
# live in Railway's variables.

# Server only. Read in route handlers, never sent to the browser.
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
GOOGLE_CLIENT_ID=
DEEPGRAM_API_KEY=
SENTRY_DSN=
# Every model call goes through OpenRouter: roster, stats and storyline imports
# to Claude Sonnet 5, live stats to Gemini 3.8 Flash.
OPENROUTER_API_KEY=
# Email/password sign-in: verification and reset emails through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# The site's own address, for links in emails (https in production).
APP_URL=

# Safe in the browser: the same OAuth client id as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
