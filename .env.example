# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any other .env file. Production and staging values
# live in Railway's variables, one set per environment.

# Server only. Read in route handlers, never sent to the browser.
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
GOOGLE_CLIENT_ID=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
SENTRY_DSN=

# Safe in the browser: the same OAuth client id as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
