# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any other .env file. Production values
# live in Railway's variables.

# Server only. Read in route handlers, never sent to the browser.
DATABASE_URL=
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
GOOGLE_CLIENT_ID=
DEEPGRAM_API_KEY=
SENTRY_DSN=
# Every model call goes through OpenRouter: roster, stats and storyline imports
# to Claude Sonnet 5, live stats to Google's Gemini 3.8 Flash, with zero data
# retention.
OPENROUTER_API_KEY=
# Optional: which model reads live stats, and how hard it thinks. Leave both
# unset (as production should) for google/gemini-3.8-flash at minimal. Also
# allowed: anthropic/claude-haiku-5.5 at low or medium (lib/livestats/settings.ts).
LIVE_STATS_MODEL=
LIVE_STATS_EFFORT=
# Optional, v7 (Oct 20, docs/LIVE_STATS_V7.md): which live stats pipeline runs.
# Unset or v6 is the window reader; v7 is the staged per-play pipeline, in
# which LIVE_STATS_MODEL/EFFORT name reader A (Claude Haiku 5.5 at low when
# unset) and these name reader B (openai/gpt-6-luna at low; "off" for A
# alone), the tie-break's effort (medium), the reconcile mode (ab, aa,
# ab-no-tiebreak, a), whether a run nobody is named for may go to the dominant back
# (false), and the per-game cost cap in dollars (1).
LIVE_STATS_PIPELINE=
LIVE_STATS_MODEL_B=
LIVE_STATS_EFFORT_B=
LIVE_STATS_TIE_BREAK_EFFORT=
LIVE_STATS_RECONCILE=
LIVE_STATS_INFER_RB=
# Optional, v6 (Oct 26): a second reader, "model" or "model:effort" from the allow-list
# (for example openai/gpt-6-luna:low), and the arbiter's effort on Claude Haiku 5.5
# (medium when unset). Unset or "off": one reader, as before.
LIVE_STATS_READER_B=
LIVE_STATS_ARBITER_EFFORT=
# Optional: how two readers' disagreements are decided ("arbiter", the default, "a" or "b"),
# and "1" to treat reader B as A (the fallback past the arbiter's guard).
LIVE_STATS_TWO_READERS_DISAGREE=
LIVE_STATS_TWO_READERS_SWAP=
LIVE_STATS_MAX_COST_USD=
# Email/password sign-in: verification and reset emails through Resend.
RESEND_API_KEY=
EMAIL_FROM=
# The site's own address, for links in emails (https in production).
APP_URL=

# Safe in the browser: the same OAuth client id as GOOGLE_CLIENT_ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
