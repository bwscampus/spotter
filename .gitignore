# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env template is safe to commit (contains no key)
!.env.example

# roster fixtures name real students; keep them out of the repo
test/fixtures/*.pdf

# the live stats test set names high school players: logs, truth files and
# exports stay on the Mac (scripts/score-livestats.ts, test/testSetNotTracked.test.ts)
*.truth.json
SpotterTestSet/
spotter-log-*.json
statcast-log-*.json
statcast-*.csv
statcast-*.xlsx
score-*.txt
score-*.json
# v7 (Oct 20): any copy of the set under another name, a log named after the
# format, and the replay's run folders (scripts/check-staged-paths.mjs is the
# pre-commit hook that refuses them too)
*SpotterTestSet*
spotter-v3-log*
*.manifest.json
